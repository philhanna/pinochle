# Copy to .env and edit.  Anything the server reads from the environment can
# go here; a variable already set in the environment wins over this file, so
# docker compose and scripts/dev.sh still override it.
#
# Every key below is commented out and shows its built-in default.  Uncomment
# only what you want to change: a key this file does not set keeps the default
# shown beside it, and the console's setup form shows that default instead.


# ---------------------------------------------------------------------------
# The table the console offers
# ---------------------------------------------------------------------------
# These fill in the setup form at /admin.  They are only a starting point --
# the form is still editable, and the game is made from whatever it is
# submitted with -- but a household that plays the same four seats every week
# sets them once here and stops retyping them.

#PINOCHLE_TEAM_NS=North-South
#PINOCHLE_TEAM_EW=East-West

# One name and one player per seat.  A type is "human" or "computer"; anything
# else is refused at startup rather than quietly ignored.
#PINOCHLE_SEAT_NORTH_NAME=North
#PINOCHLE_SEAT_NORTH_TYPE=computer
#PINOCHLE_SEAT_EAST_NAME=East
#PINOCHLE_SEAT_EAST_TYPE=computer
#PINOCHLE_SEAT_SOUTH_NAME=South
#PINOCHLE_SEAT_SOUTH_TYPE=human
#PINOCHLE_SEAT_WEST_NAME=West
#PINOCHLE_SEAT_WEST_TYPE=computer


# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# The console's credential.  Left unset, the server generates one for the run
# and logs it at startup, which is enough for an operator running one game for
# an evening; set it to keep the same token across restarts.
#PINOCHLE_ADMIN_TOKEN=

# What the join links handed out by the console are addressed to.  Change this
# when the players are not all on this machine -- a link to localhost is no use
# to anybody else.
#PINOCHLE_PUBLIC_BASE_URL=http://localhost:8000

# Docker Compose host binding (not read by the Python application). Loopback
# is safest behind a reverse proxy. To allow direct access from other hosts,
# set the bind address to 0.0.0.0 and protect the port with a firewall.
#PINOCHLE_BIND_ADDRESS=127.0.0.1
#PINOCHLE_PORT=8000


# ---------------------------------------------------------------------------
# Appearance
# ---------------------------------------------------------------------------
# Which card back the table is dealt with: the plain file name of an image in
# pinochle/card_images/backs/, with or without its extension.  Not a path --
# the server knows where the artwork lives and which format to serve.
#
# Bundled: abstract, abstract_clouds, abstract_scene, astronaut, blue, blue2,
# cars, castle, fish, frog, red, red2
#PINOCHLE_CARD_BACK=blue


# ---------------------------------------------------------------------------
# Pace of play
# ---------------------------------------------------------------------------
# How long a completed trick stays on the table before it is gathered to its
# winner (UI-15).  Counted by the server, never by a browser (RT-8).
#PINOCHLE_TRICK_CLEAR_SECONDS=1.5

# How long a computer seat pauses before it moves, so that people can follow
# the play (FR-75c, RT-7).  Zero makes an all-computer game run flat out.
#PINOCHLE_COMPUTER_DELAY_SECONDS=1.0


# ---------------------------------------------------------------------------
# Streams
# ---------------------------------------------------------------------------
# How often an idle event stream sends a keepalive, so that a proxy in the
# middle does not decide the connection has gone away.
#PINOCHLE_SSE_KEEPALIVE_SECONDS=15

# How many frames may queue for one client before the slowest reader starts
# losing them.  A reader that falls this far behind has stopped reading.
#PINOCHLE_SSE_QUEUE_MAXSIZE=256


# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Seed every shuffle, so a game can be replayed exactly (NFR-7).  Leave unset
# for real play: a seeded game deals the same cards every time.
#PINOCHLE_SHUFFLE_SEED=

# Where the built front end is served from.
#PINOCHLE_FRONTEND_DIR=frontend

# CRITICAL, ERROR, WARNING, INFO or DEBUG.
#PINOCHLE_LOG_LEVEL=INFO
