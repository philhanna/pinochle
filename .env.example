# Copy to .env and edit.  Anything the server reads from the environment can
# go here; a variable already set in the environment wins over this file, so
# docker compose and scripts/dev.sh still override it.

# Which card back the table is dealt with: the plain file name of an image in
# pinochle/card_images/backs/, with or without its extension.  Not a path —
# the server knows where the artwork lives and which format to serve.
#
# Bundled: abstract, abstract_clouds, abstract_scene, astronaut, blue, blue2,
# cars, castle, fish, frog, red, red2
PINOCHLE_CARD_BACK=blue
